# Blender MTL File: 'sphere.blend'
# Material Count: 1

newmtl Material.001
# Shininess — різкість відбиття джерела світла на поверхні (92 = напівглянець)
# У шейдері: uMaterial.shininess
Ns 92.156863

# Ambient — колір у тіні (0,0,0 = повна темрява в тіні)
# У шейдері: uMaterial.ambient
Ka 0.000000 0.000000 0.000000

# Diffuse — основний колір поверхні (0.8,0.8,0.8 = світло-сірий)
# У шейдері: uMaterial.diffuse, замінюємо це значення на золото у коді
Kd 0.800000 0.800000 0.800000

# Specular — колір відбиття джерела світла на поверхні (0.3,0.3,0.3 = нейтральний сірий блік)
# У шейдері: uMaterial.specular, замінюємо це значення на золото у коді
Ks 0.297297 0.297297 0.297297

# Index of Refraction — коефіцієнт заломлення (для скла/води)
# Для непрозорих матеріалів не використовується
Ni 1.000000

# Dissolve — непрозорість (1.0 = повністю непрозорий)
d 1.000000

# Illumination model — модель освітлення, 2 = ambient + diffuse + specular (Blinn-Phong)
illum 2

